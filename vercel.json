{
  "rewrites": [
    {
      "source": "/api/nvidia-genai/:match*",
      "destination": "https://ai.api.nvidia.com/:match*"
    },
    {
      "source": "/api/nvidia-nim/:match*",
      "destination": "https://integrate.api.nvidia.com/:match*"
    },
    {
      "source": "/api/groq/:match*",
      "destination": "https://api.groq.com/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
